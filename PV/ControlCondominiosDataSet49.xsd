                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>(SELECT CG.*, C.*, P.RazonSocial, RC.Total, RC.Recargo, RC.DescuentoPago, RC.ClaveDocumento, D.Nombre, CB.Nombre, RC.Divisa, DI.TipoCambio
 FROM Egreso_General AS CG, Egreso AS C, Proveedor AS P, RecepcionProducto AS RC, Documento AS D, CuentasBancarias AS CB, Divisas AS DI
 WHERE CG.Folio = C.FolioGeneral
   AND C.ClaveProveedor = P.IdProveedor
   AND C.Folio = RC.Folio
   AND RC.ClaveDocumento = D.Clave
   AND C.CuentaBancaria = CB.Clave
   AND RC.Divisa = DI.Nombre
   AND C.FolioGeneral = @Folio
   AND C.Tipo = 'P')

UNION

(SELECT CG.*, C.*, P.RazonSocial, RC.Total, RC.Recargo, RC.DescuentoPago, RC.ClaveDocumento, D.Nombre, CB.Nombre, RC.Divisa, DI.TipoCambio
 FROM Egreso_General AS CG, Egreso AS C, Proveedor AS P, RegistroGastos AS RC, Documento AS D, CuentasBancarias AS CB, Divisas AS DI
 WHERE CG.Folio = C.FolioGeneral
   AND C.ClaveProveedor = P.IdProveedor
   AND C.Folio = RC.Folio
   AND RC.ClaveDocumento = D.Clave
   AND C.CuentaBancaria = CB.Clave
   AND RC.Divisa = DI.Nombre
   AND C.FolioGeneral = @Folio
   AND C.Tipo = 'G')

UNION

(SELECT CG.*, C.*, P.RazonSocial, RC.Total, RC.Recargo, RC.DescuentoPago, RC.ClaveDocumento, D.Nombre, CB.Nombre, RC.Divisa, DI.TipoCambio
 FROM Egreso_General AS CG, Egreso AS C, Proveedor AS P, NotasGasto AS RC, Documento AS D, CuentasBancarias AS CB, Divisas AS DI
 WHERE CG.Folio = C.FolioGeneral
   AND C.ClaveProveedor = P.IdProveedor
   AND C.Folio = RC.Folio
   AND RC.ClaveDocumento = D.Clave
   AND C.CuentaBancaria = CB.Clave
   AND RC.Divisa = DI.Nombre
   AND C.FolioGeneral = @Folio
   AND C.Tipo = 'NCG')

UNION

(SELECT CG.*, C.*, P.RazonSocial, RC.Total, RC.Recargo, RC.DescuentoPago, RC.ClaveDocumento, D.Nombre, CB.Nombre, RC.Divisa, DI.TipoCambio
 FROM Egreso_General AS CG, Egreso AS C, Proveedor AS P, RegistroReembolso AS RC, Documento AS D, CuentasBancarias AS CB, Divisas AS DI
