  <Code>Public Function ObtenerRangoFechas(ByVal fechaInicio As String, ByVal fechaFin As String) As String
    If String.IsNullOrEmpty(fechaInicio) Then
        Return "Todos los ingresos"
    Else
        Dim ci As New System.Globalization.CultureInfo("es-MX")
        Dim dIni As Date = CDate(fechaInicio)
        Dim dFin As Date = CDate(fechaFin)

        Dim mesIni As String = ci.DateTimeFormat.GetMonthName(dIni.Month)
        Dim mesFin As String = ci.DateTimeFormat.GetMonthName(dFin.Month)
        mesIni = Char.ToUpper(mesIni(0)) &amp; mesIni.Substring(1)
        mesFin = Char.ToUpper(mesFin(0)) &amp; mesFin.Substring(1)

        Return "Del " &amp; dIni.Day.ToString() &amp; " " &amp; mesIni &amp; " del " &amp; dIni.Year.ToString() &amp; _
               " al " &amp; dFin.Day.ToString() &amp; " " &amp; mesFin &amp; " " &amp; dFin.Year.ToString()
    End If
End Function</Code>
