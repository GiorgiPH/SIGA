                    <CommandText>select Folio, ClaveDocumento, O.Estatus, Fecha, DiasVence, O.Divisa, O.TipoCambio, O.Subtotal, O.Descuento, Cargo, O.Total, TotalPartidas, Notas, Consecutivo,
