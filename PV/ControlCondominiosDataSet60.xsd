                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>(
    select 
        O.Folio,           -- Especificamos que Folio viene de la tabla Remision (alias O)
        O.ClaveDocumento,  
        O.Estatus, 
        O.Fecha, 
        O.DiasVence, 
        O.Divisa, 
        O.TipoCambio, 
        O.Subtotal, 
        O.Descuento, 
        O.Cargo,          -- Especificamos que Cargo viene de la tabla Remision (alias O)
        O.Total, 
        O.TotalPartidas, 
        O.Notas, 
        O.Consecutivo,
        P.Partida, 
        Cast(P.ClaveProducto as varchar), 
        PS.Descripcion, 
        PS.Alias, 
        P.Cantidad as CantidadPartida, 
        P.Subtotal as SubtotalPartida, 
        P.Descuento as DescuentoPartida, 
        P.Precio as PrecioPartida, 
        P.Total as TotalPartida, 
        P.Impuesto as ImpuestoPartida, 
        P.Unidad as UnidadPartida, 
        PS.SATImpuestos,
		1 as identificador,
		0.00 AS GloablDescuento,
		0.00 AS GlobalImpuesto,
		0.00 AS GlobalCargo,
0 as IncluyeIva
    from 
        Remision as O
    Join 
        PartidaRemision as P on P.FolioRemision = O.Folio
    Join 
        ProductosServicios as PS on PS.ClaveProducto = P.ClaveProducto
    Where 
        O.Folio = @Folio       -- Especificamos que Folio viene de la tabla Remision (alias O)
)
union
(
    select 
        O.Folio,          -- Especificamos que Folio viene de la tabla Remision (alias O)
        O.ClaveDocumento, 
        O.Estatus, 
        O.Fecha, 
        O.DiasVence, 
        O.Divisa, 
        O.TipoCambio, 
        O.Subtotal, 
        O.Descuento, 
        O.Cargo,          -- Especificamos que Cargo viene de la tabla Remision (alias O)
        O.Total, 
        O.TotalPartidas, 
        O.Notas, 
        O.Consecutivo,
        0 as Partida, 
        CG.Clave as ClaveProducto, 
        CG.Nombre as Descripcion, 
        '' as Alias, 
        '1' as CantidadPartida, 
        '0.00' as SubtotalPartida, 
        0.00 as DescuentoPartida, 
        0.00 as PrecioPartida, 
        0.00 as TotalPartida, 
        0.00 as ImpuestoPartida, 
        '' as UnidadPartida, 
        '0.00' as SATImpuestos,
		2 as identificador,
		CGR.Descuento AS GloablDescuento,
		iif(CG.Clase='Impuesto',  CGR.Cargo, 0) AS GlobalImpuesto,
		iif(CG.Clase='Cargo',  CGR.Cargo, 0) AS GlobalCargo,
CGR.IncluyeIva
    from 
        Remision as O
    Join 
        ConceptoGlobalesRemision as CGR on CGR.Folio = O.Folio
    Join 
        ConceptosGlobales as CG on CG.Clave = CGR.ClaveConceptoG
    Where 
        O.Folio = @Folio       -- Especificamos que Folio viene de la tabla Remision (alias O)
)</CommandText>
