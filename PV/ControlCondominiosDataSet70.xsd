                    <CommandText> Select AC.Folio as FolioAnticipo, AC.Tipo,(convert(varchar, P.IdProveedor) + '-' + P.RazonSocial) as Proveedor, AC.Pago as PagoAnticipoAplicado, AC.Fecha as FechaAplicado, R.*, (D.Clave + '-' + D.Nombre) as Documento
