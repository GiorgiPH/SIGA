          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="Anticipo_GeneralTableAdapter" GeneratorDataComponentClassName="Anticipo_GeneralTableAdapter" Name="Anticipo_General" UserDataComponentName="Anticipo_GeneralTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="ControlCondominiosConnectionString (Settings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT
    A.Folio                                                AS FolioAnticipo,
    (CONVERT(varchar, P.IdCliente) + '-' + P.RazonSocial)  AS Propietario,
    A.Importe                                              AS ImporteAnticipo,
    A.Saldo                                                AS SaldoAnticipo,
    AC.Pago                                                AS PagoAnticipoAplicado,
    AC.Fecha                                                AS FechaAplicado,
    CASE AC.TipoDocumento
        WHEN 'FACTURA' THEN 'Factura'
        ELSE 'Remisión'
    END                                                     AS TipoDocumentoTexto,
    Doc.Folio,
    Doc.ClaveDocumento,
    Doc.Estatus,
    Doc.Fecha,
    Doc.ClaveProveedor,
    Doc.Divisa,
    Doc.TipoCambio,
    Doc.Subtotal,
    Doc.Descuento,
    Doc.Cargo,
    Doc.Total,
    Doc.TotalPartidas,
    Doc.Notas,
    Doc.Elaborado,
    Doc.Recargo,
    Doc.DescuentoPago,
    Doc.Saldo,
    Doc.FolioOrden,
    Doc.Consecutivo,
    Doc.Almacen,
    Doc.Referencia,
    Doc.Condominio,
    Doc.Extension,
    Doc.Archivo,
    Doc.DiasVence,
    Doc.FechaVence,
    Doc.FolioOrdenPedidoCliente,
    Doc.UltimoAbono,
    Doc.Autorizado,
    Doc.FechaAutoriza,
    Doc.UsuarioAutoriza,
    Doc.FolioMovimiento,
    Doc.CentroCostos,
    Doc.IdProyecto,
    (D.Clave + '-' + D.Nombre)                             AS Documento
FROM Anticipo AS A
INNER JOIN AnticipoCobros AS AC ON A.Folio = AC.Anticipo
INNER JOIN Clientes AS P ON A.ClavePropietario = P.IdCliente
INNER JOIN (
 
    SELECT
        R.Folio, R.ClaveDocumento, R.Estatus, R.Fecha, R.ClaveProveedor, R.Divisa, R.TipoCambio,
        R.Subtotal, R.Descuento, R.Cargo, R.Total, R.TotalPartidas, R.Notas, R.Elaborado, R.Recargo,
        R.DescuentoPago, R.Saldo, R.FolioOrden, R.Consecutivo, R.Almacen, R.Referencia, R.Condominio,
        R.Extension, R.Archivo, R.DiasVence, R.FechaVence, R.FolioOrdenPedidoCliente,
        CAST(NULL AS decimal(18, 2)) AS UltimoAbono,
        R.Autorizado, R.FechaAutoriza, R.UsuarioAutoriza, R.FolioMovimiento, R.CentroCostos, R.IdProyecto,
        'REMISION' AS TipoDocumento
    FROM Remision AS R
 
    UNION ALL
 
    SELECT
        F.Folio, F.ClaveDocumento, F.Estatus, F.Fecha, F.ClaveProveedor, F.Divisa, F.TipoCambio,
        F.Subtotal, F.Descuento, F.Cargo, F.Total, F.TotalPartidas, F.Notas, F.Elaborado, F.Recargo,
        F.DescuentoPago, F.Saldo, F.FolioOrden, F.Consecutivo, F.Almacen, F.Referencia, F.Condominio,
        F.Extension, F.Archivo, F.DiasVence, F.FechaVence,
        CAST(NULL AS int) AS FolioOrdenPedidoCliente,
        F.UltimoAbono,
        F.Autorizado, F.FechaAutoriza, F.UsuarioAutoriza, F.FolioMovimiento, F.CentroCostos, F.IdProyecto,
        'FACTURA' AS TipoDocumento
    FROM Factura AS F
 
) AS Doc ON Doc.Folio = AC.Folio AND Doc.TipoDocumento = AC.TipoDocumento
INNER JOIN Documento AS D ON D.Clave = Doc.ClaveDocumento
WHERE A.Folio = @Anticipo AND AC.FolioGeneral = @FolioGeneral;</CommandText>
                    <Parameters>
                      <Parameter AllowDbNull="false" AutogeneratedName="Anticipo" ColumnName="Folio" DataSourceName="Administracion.dbo.Anticipo" DataTypeServer="int" DbType="Int32" Direction="Input" ParameterName="@Anticipo" Precision="0" ProviderType="Int" Scale="0" Size="4" SourceColumn="FolioAnticipo" SourceColumnNullMapping="false" SourceVersion="Current" />
                      <Parameter AllowDbNull="true" AutogeneratedName="FolioGeneral" ColumnName="FolioGeneral" DataSourceName="Administracion.dbo.AnticipoCobros" DataTypeServer="int" DbType="Int32" Direction="Input" ParameterName="@FolioGeneral" Precision="0" ProviderType="Int" Scale="0" Size="4" SourceColumn="FolioGeneral" SourceColumnNullMapping="false" SourceVersion="Current" />
                    </Parameters>
                  </DbCommand>
                </SelectCommand>
